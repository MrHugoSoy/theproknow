# ── Supabase (Project Settings → API) ──────────────────────────
NEXT_PUBLIC_SUPABASE_URL=https://TU-PROYECTO.supabase.co
# "anon" key (o "publishable" key en proyectos nuevos). Es pública por diseño; la seguridad la da RLS.
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# ── Solo para el seed local (scripts). NUNCA con prefijo NEXT_PUBLIC_ ni en Vercel del cliente ──
SUPABASE_SERVICE_ROLE_KEY=

# ── URL pública del sitio (redirects de auth, sitemap, OG) ────────
# Local: http://localhost:3000 · Producción: https://tu-dominio.vercel.app
NEXT_PUBLIC_SITE_URL=http://localhost:3000
